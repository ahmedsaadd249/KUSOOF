// Cloudflare Workers (static assets) — deploys only the built site in dist/.
// The build runs first in Workers Builds: `node scripts/build.mjs`
// (Settings › Build › Build command), using the build variables
// SUPABASE_URL, SUPABASE_ANON_KEY and APP_URL (public values only).
// Secrets never go here: they stay in Supabase and your local .env.
{
  "name": "kusoof",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
