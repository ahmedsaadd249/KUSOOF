// Cloudflare Workers (static assets) — deploys only the built site in dist/.
// `npx wrangler deploy` first runs the build below, so the Workers Builds
// deploy command alone is enough (no separate build command needed).
// The build reads the build variables SUPABASE_URL, SUPABASE_ANON_KEY and
// APP_URL (public values only). Secrets never go here: they stay in
// Supabase and your local .env.
{
  "name": "kusoof",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
