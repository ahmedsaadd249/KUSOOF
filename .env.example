# ---------------------------------------------------------------------------
# KUSOOF environment — copy to .env and fill in. Never commit .env.
# Public values are copied into js/env.public.js by:  node scripts/write-env.mjs
# Secret values are NEVER written to the frontend (the script refuses to).
# ---------------------------------------------------------------------------

# Supabase (Project Settings › API)
SUPABASE_URL=
# Public "anon" key (safe in the browser; RLS protects the data)
SUPABASE_ANON_KEY=
# SECRET — local scripts only. Never put it in js/ or a browser.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET — personal access token, only for scripts/configure-supabase.mjs
# (https://supabase.com/dashboard/account/tokens). Revoke it when done.
SUPABASE_ACCESS_TOKEN=

# Brevo (SECRET — also set as Supabase Edge Function secrets, see docs/SETUP.md)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=KUSOOF
# Brevo SMTP (SECRET — entered in Supabase › Authentication › SMTP Settings)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Google Maps (browser key — public by nature; protect it with HTTP-referrer
# and API restrictions in Google Cloud, see docs/SETUP.md)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Application
# Public URL of the site (used in email links and the logo in emails)
APP_URL=http://localhost:5173
# The store's single administrator (see docs/SETUP.md › Admin)
ADMIN_EMAIL=
